{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autokagglab.dev/schemas/result.schema.json",
  "title": "Result",
  "description": "Evaluation result of one experiment: fold-level and aggregate metrics plus metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id", "metric_name", "direction", "fold_metrics", "mean", "std", "runtime_seconds"],
  "properties": {
    "experiment_id": { "type": "string" },
    "metric_name": { "type": "string", "enum": ["roc_auc", "log_loss", "rmse", "mae", "r2"] },
    "direction": { "type": "string", "enum": ["max", "min"] },
    "fold_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fold", "value"],
        "properties": {
          "fold": { "type": "integer", "minimum": 0 },
          "value": { "type": "number" }
        }
      }
    },
    "mean": { "type": "number" },
    "std": { "type": "number", "minimum": 0 },
    "runtime_seconds": { "type": "number", "minimum": 0 },
    "environment": {
      "type": "object",
      "properties": {
        "python": { "type": "string" },
        "platform": { "type": "string" },
        "packages": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "mlflow_run_id": { "type": ["string", "null"] },
    "conclusion": { "type": "string", "description": "Required on COMPLETED; every result produces a conclusion (constitution I)." }
  }
}
